rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function votingOpen() {
      // Voting closes 16 Nov 2026 10:00 India time (= 04:30 UTC)
      return request.time < timestamp.date(2026, 11, 16) + duration.value(270, 'm');
    }

    // votes/{voter} = { candidate, votedAt }  -- secret until voting ends
    match /votes/{voter} {
      allow read: if !votingOpen();
      allow create: if votingOpen()
        && voter in ['joby', 'anna', 'asha', 'aaron', 'anton']
        && request.resource.data.keys().hasOnly(['candidate', 'votedAt'])
        && request.resource.data.candidate in ['asha', 'aaron', 'joby']
        && request.resource.data.candidate != voter
        && request.resource.data.votedAt == request.time
        && existsAfter(/databases/$(database)/documents/voted/$(voter));
      allow update, delete: if false;
    }

    // voted/{voter} = {}  -- only shows THAT someone voted, used for "Status"
    match /voted/{voter} {
      allow get: if true;
      allow list: if false;
      allow create: if voter in ['joby', 'anna', 'asha', 'aaron', 'anton']
        && request.resource.data.keys().size() == 0
        && existsAfter(/databases/$(database)/documents/votes/$(voter));
      allow update, delete: if false;
    }
  }
}
